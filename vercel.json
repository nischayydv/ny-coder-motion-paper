{
  "functions": {
    "api/index.py": {
      "memory": 512,
      "maxDuration": 30
    },
    "api/pdf.js": {
      "memory": 1024,
      "maxDuration": 60,
      "includeFiles": "node_modules/@sparticuz/chromium/**"
    }
  },
  "routes": [
    { "src": "/api/pdf", "dest": "api/pdf.js" },
    { "src": "/(.*)", "dest": "api/index.py" }
  ]
}
