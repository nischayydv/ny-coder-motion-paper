{
  "builds": [
    { "src": "api/index.py", "use": "@vercel/python" },
    {
      "src": "api/pdf.js",
      "use": "@vercel/node",
      "config": { "includeFiles": "node_modules/@sparticuz/chromium/**" }
    }
  ],
  "routes": [
    { "src": "/api/pdf", "dest": "api/pdf.js" },
    { "src": "/(.*)", "dest": "api/index.py" }
  ]
}
